@model List<RoleVM>
@{
    ViewData["Title"] = "Role Management";
}

<div class="header">
    <h2>@ViewData["Title"]</h2>
    <div class="subtitle">Manage Roles in this page</div>
    <div class="meta">Last refreshed @DateTime.Now.ToString("MMM dd, yyyy")</div>
</div>
<div class="admin-toolbar">
    <a asp-action="Create" class="btn-primary">
        <i class="fa-solid fa-plus"></i> New Role
    </a>
</div>
<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Role Name</th>
                <th>Assigned Users</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Name</td>
                    <td>@r.UserCount</td>
                    <td class="text-right">
                        <a asp-action="Edit" asp-route-id="@r.Id" title="Edit">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@r.Id" title="Delete" class="text-danger">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>