@model RoleVM
@{
    ViewData["Title"] = "Create Role";
}

<form asp-area="Admin" asp-controller="RoleManagement" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="validation-summary"></div>
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"></span>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn-primary">Create Role</button>
        <a asp-action="Index" class="btn-secondary">Cancel</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}