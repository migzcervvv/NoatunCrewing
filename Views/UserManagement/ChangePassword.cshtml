@model AdminChangePasswordVM
@{
    ViewData["Title"] = "Change Password";
}

<p>Setting a new password for <strong>@Model.UserName</strong>.</p>
<form asp-area="Admin" asp-controller="UserManagement" asp-action="ChangePassword" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="UserName" />
    <div asp-validation-summary="All" class="validation-summary"></div>
    <div class="form-grid">
        <div class="form-group">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" type="password" class="form-control" />
            <span asp-validation-for="NewPassword"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn-primary">Change Password</button>
        <a asp-action="Index" class="btn-secondary">Cancel</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}