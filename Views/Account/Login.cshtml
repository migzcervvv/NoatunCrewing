@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Noatun MGT</title>
    <style>
        :root {
            --red: #d31027;
            --red-dark: #8c0f1e;
            --ink: #111111;
            --ink-soft: #333333;
            --bg: #fafafa;
            --card: #ffffff;
            --muted: #7a7a7a;
            --border: #e4e4e4;
            --radius: 12px;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0 !important;
            padding: 0 !important;
            min-height: 100%;
        }

        body {
            background: var(--bg);
            color: var(--ink);
            font-family: "Inter Tight", -apple-system, Segoe UI, Roboto, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .layout {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr;
        }

        .brand {
            display: none;
            position: relative;
            overflow: hidden;
            padding: 64px 56px;
            background: linear-gradient(160deg, #191919 0%, #0d0d0d 55%, #4a0d16 140%);
            color: #fff;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand-content {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
        }

        .brand::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
            background-size: 56px 56px;
        }

        .glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            pointer-events: none;
        }

        .glow-1 {
            top: -130px;
            left: -100px;
            width: 380px;
            height: 380px;
            background: rgba(211,16,39,.35);
        }

        .glow-2 {
            right: -100px;
            bottom: -130px;
            width: 420px;
            height: 420px;
            background: rgba(211,16,39,.22);
        }

        .brand-rule {
            width: 80px;
            height: 4px;
            border-radius: 999px;
            background: var(--red);
            margin-bottom: 32px;
        }

        .brand h1 {
            font-family: "Archivo", sans-serif;
            font-size: 52px;
            line-height: 1.05;
            font-weight: 800;
            letter-spacing: -1.5px;
            margin: 0;
            max-width: 520px;
        }

            .brand h1 span {
                display: block;
                color: var(--red);
            }

        .brand p {
            margin: 24px 0 0;
            max-width: 460px;
            font-size: 16px;
            line-height: 1.65;
            color: rgba(255,255,255,.6);
        }

        .stats {
            display: flex;
            align-items: center;
            gap: 32px;
        }

            .stats .value {
                font-family: "Archivo", sans-serif;
                font-size: 24px;
                font-weight: 700;
                margin: 0;
            }

            .stats .label {
                margin: 2px 0 0;
                font-size: 11px;
                letter-spacing: .18em;
                text-transform: uppercase;
                color: rgba(255,255,255,.5);
            }

            .stats .divider {
                width: 1px;
                height: 40px;
                background: rgba(255,255,255,.15);
            }

        .logo-slot {
            width: 208px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f4f4f4;
            color: var(--muted);
        }

            .logo-slot img {
                max-height: 240px;
                max-width: 100%;
                object-fit: cover;
            }

            .logo-slot.dark {
                border-color: rgba(255,255,255,.3);
                background: rgba(255,255,255,.05);
                color: rgba(255,255,255,.7);
            }

        .form-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 20px;
        }

        .form-wrap {
            width: 100%;
            max-width: 420px;
        }

        .mobile-logo {
            display: flex;
            justify-content: center;
            margin-bottom: 40px;
        }

        .eyebrow {
            font-family: "Archivo", sans-serif;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .28em;
            text-transform: uppercase;
            color: var(--red);
            margin: 0;
        }

        h2 {
            font-family: "Archivo", sans-serif;
            font-size: 34px;
            font-weight: 800;
            letter-spacing: -1px;
            margin: 12px 0 0;
        }

        .subtitle {
            margin: 8px 0 32px;
            font-size: 14px;
            color: var(--muted);
        }

        .field {
            margin-bottom: 20px;
        }

        .field-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 8px;
        }

            .field label,
            .field-head label {
                display: block;
                font-size: 14px;
                font-weight: 500;
                color: var(--ink-soft);
                margin-bottom: 8px;
            }

            .field-head label {
                margin-bottom: 0;
            }

            .field-head a {
                font-size: 12px;
                font-weight: 500;
                color: var(--red);
                text-decoration: none;
            }

                .field-head a:hover {
                    text-decoration: underline;
                }

        .control {
            position: relative;
        }

            .control .form-control {
                width: 100%;
                border-radius: var(--radius);
                border: 1px solid var(--border);
                background: var(--card);
                padding: 14px 16px;
                font-size: 15px;
                font-family: inherit;
                color: var(--ink);
                transition: border-color .2s ease, box-shadow .2s ease;
            }

                .control .form-control::placeholder {
                    color: var(--muted);
                }

                .control .form-control:focus {
                    outline: none;
                    border-color: var(--red);
                    box-shadow: 0 0 0 4px rgba(211,16,39,.14);
                }

        .toggle-pw {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            cursor: pointer;
            padding: 6px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--muted);
        }

            .toggle-pw:hover {
                color: var(--ink);
            }

        .remember {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            color: var(--ink-soft);
            margin-bottom: 24px;
        }

            .remember input[type="checkbox"] {
                width: 16px;
                height: 16px;
                accent-color: var(--red);
                margin: 0;
            }

            .remember label {
                margin: 0;
                font-weight: 400;
                cursor: pointer;
            }

        .btn-primary {
            width: 100%;
            border: 0;
            cursor: pointer;
            border-radius: var(--radius);
            padding: 15px 20px;
            font-family: "Archivo", sans-serif;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: .04em;
            color: #fff;
            background: linear-gradient(135deg, var(--red), var(--red-dark));
            box-shadow: 0 18px 40px -18px rgba(211,16,39,.65);
            transition: transform .18s ease, filter .18s ease;
        }

            .btn-primary:hover {
                filter: brightness(1.06);
                transform: translateY(-1px);
            }

            .btn-primary:active {
                transform: translateY(0);
            }

        .foot {
            margin-top: 40px;
            text-align: center;
            font-size: 12px;
            color: var(--muted);
        }

        .text-danger {
            color: var(--red);
            font-size: 13px;
            display: block;
            margin-top: 6px;
        }

        .validation-summary-errors ul {
            margin: 0 0 20px;
            padding-left: 18px;
        }

        @@media (min-width: 1024px) {
            .layout {
                grid-template-columns: 1.05fr 1fr;
            }

            .brand {
                display: flex;
            }

            .mobile-logo {
                display: none;
            }

            .form-panel {
                padding: 48px 32px;
            }

            h2 {
                font-size: 38px;
            }
        }
    </style>
</head>
<body>

    <div class="layout">
        <section class="brand">
            <div class="glow glow-1"></div>
            <div class="glow glow-2"></div>

            <div class="brand-content">
                <div>
                    <div class="logo-slot dark">
                        <img src="~/images/Noatun-Logo.png" alt="Noatun Management" class="img-fluid" />
                    </div>
                </div>

                <div>
                    <div class="brand-rule"></div>
                    <h1>Control every<span>moving part.</span></h1>
                    <p>One secure portal for operations, reporting and team access. Sign in to pick up exactly where you left off.</p>
                </div>

                <div class="stats">
                    <div>
                        <p class="value">Crewing</p>
                        <p class="label">Management</p>
                    </div>

                    <div class="divider"></div>

                    <div>
                        <p class="value">Fleet</p>
                        <p class="label">Operations</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="form-panel">
            <div class="form-wrap">

                <div class="mobile-logo">
                    <div class="logo-slot">
                        <img src="~/images/Noatun-Logo.png" alt="Noatun Management" class="img-fluid" />
                    </div>
                </div>

                <p class="eyebrow">Welcome back</p>
                <h2>Log in</h2>
                <p class="subtitle">Enter your credentials to access your account.</p>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="field">
                        <label asp-for="UserName"></label>
                        <div class="control">
                            <input asp-for="UserName" class="form-control" placeholder="yourname" autocomplete="username" />
                        </div>
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <div class="field-head">
                            <label asp-for="Password"></label>
                            <a href="#" style="cursor:pointer">Forgot password?</a>
                        </div>
                        <div class="control">
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" class="toggle-pw" onclick="togglePassword(this)" aria-label="Show password">Show</button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="remember">
                        <input asp-for="RememberMe" />
                        <label asp-for="RememberMe"></label>
                    </div>

                    <button type="submit" class="btn-primary">Log in &rarr;</button>
                </form>

                <p class="foot">Protected area. Unauthorized access is monitored and logged.</p>
            </div>
        </section>
    </div>

    <script>
        function togglePassword(btn) {
            var input = btn.parentNode.querySelector('input');
            if (!input) return;
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.textContent = show ? 'Hide' : 'Show';
            btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        }
    </script>

</body>
</html>