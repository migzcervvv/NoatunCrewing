@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var title = ViewData["Title"] != null ? $"{ViewData["Title"]} - Noatun MGT" : "Noatun Management";
    string profilePhotoUrl = "https://ui-avatars.com/api/?name=Administrator";

    if (User.Identity?.IsAuthenticated == true)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null && !string.IsNullOrEmpty(currentUser.ProfilePhotoPath))
        {
            profilePhotoUrl = currentUser.ProfilePhotoPath;
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site-layout.css" />
    <link rel="stylesheet" href="~/css/site-admin.css" />
    <link rel="stylesheet" href="~/css/toast.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="topbar">
        <div class="topbar-left">
            <button id="openSidebar" class="mobile-menu">
                <i class="fa-solid fa-bars"></i>
            </button>
            <a asp-controller="Home" asp-action="Index" class="brand">
                <img src="@Url.Content("~/images/Noatun-Logo.png")" alt="Logo" />
            </a>
        </div>

        <div class="topbar-right">
            <button class="header-icon">
                <i class="fa-regular fa-bell"></i>
            </button>

            <div class="user-menu">
                <button id="userMenuButton">
                    <img src="@profilePhotoUrl" class="avatar" />
                    <span>@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Guest")</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </button>

                <div id="userDropdown">
                    <a asp-controller="Account" asp-action="Profile">
                        <i class="fa-solid fa-user"></i> Profile
                    </a>
                    <a asp-controller="Account" asp-action="ChangePassword">
                        <i class="fa-solid fa-key"></i> Change Password
                    </a>
                    <hr />
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                            <button type="submit" class="logout-button">
                                <i class="fa-solid fa-right-from-bracket"></i> Logout
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </header>

    <div id="mobileOverlay"></div>

    <partial name="_Nav" />

    <main class="page-content">
        <partial name="_StatusToast" />
        @RenderBody()
    </main>

    <footer>
        <div>© @DateTime.Now.Year Noatun Management System</div>
        <div>Version 1.0.0</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site-layout.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>